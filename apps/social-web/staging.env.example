# PB-SOCIAL-003C: EXAMPLE ONLY. DO NOT enter real values in Git.
# Copy to a private, untracked file with restrictive owner permissions.
# Never reuse the existing postbro-core or media project by default.
#
# One explicit isolated Supabase project for both Auth and PostgreSQL.
SOCIAL_STAGING_PROJECT_REF=replace_with_your_20_character_staging_ref
SOCIAL_STAGING_SUPABASE_URL=https://replace_with_your_20_character_staging_ref.supabase.co
SOCIAL_STAGING_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
#
# Use the corresponding staging project's DIRECT database endpoint:
# postgresql://postgres:URL_ENCODED_PASSWORD@db.<staging_ref>.supabase.co:5432/postgres
# Or corresponding Supabase session pooler, whose username is postgres.<staging_ref>.
# NEVER use root DATABASE_URL. TLS certificate verification is mandatory.
SOCIAL_STAGING_DATABASE_URL=postgresql://postgres:REPLACE_PASSWORD@db.replace_with_your_20_character_staging_ref.supabase.co:5432/postgres
#
# Loopback-only listener (not public; reverse proxy requires later approval).
SOCIAL_STAGING_HOST=127.0.0.1
SOCIAL_STAGING_PORT=3201
