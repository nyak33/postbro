# PB-SOCIAL-003C — PRE-LAUNCH TESTING. PLACEHOLDERS ONLY; DO NOT COMMIT SECRETS.
# Use your EXISTING Supabase postbro-core project; separate postbro_social schema.
# No second Supabase project or local Supabase Docker stack needed.
# Keep in a private file with restrictive permissions; not in Git or chat.
SOCIAL_PRELAUNCH_PROJECT_REF=nqjlgalyjxifzisitzfa
SOCIAL_PRELAUNCH_SHARED_PROJECT_CONFIRM=postbro-core
SOCIAL_PRELAUNCH_SUPABASE_URL=https://nqjlgalyjxifzisitzfa.supabase.co
SOCIAL_PRELAUNCH_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_PROJECT_KEY
# Connection belongs to this same project; obtain through Supabase dashboard.
# Credentials MUST remain server-only. Never fall back to root DATABASE_URL.
# Prefer a separately scoped runtime DB role with permission to SET ROLE authenticated.
SOCIAL_PRELAUNCH_DATABASE_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_PASSWORD@db.nqjlgalyjxifzisitzfa.supabase.co:5432/postgres
# App runs separately from existing PostBro (3000) and Postiz. No public bind.
SOCIAL_PRELAUNCH_HOST=127.0.0.1
SOCIAL_PRELAUNCH_PORT=3201

# Future shared login: OFF until OAuth server, consent UI and Postiz OAuth client
# have been independently verified. No change to live PostBro/Postiz login.
SOCIAL_PRELAUNCH_SSO_ENABLED=false
# The following are server-only staging/pilot values; NEVER paste real values into Git/chat.
# SOCIAL_PRELAUNCH_SSO_CLIENT_ID=YOUR_OAUTH_CLIENT_ID
# SOCIAL_PRELAUNCH_SSO_CLIENT_SECRET=SERVER_ONLY_VALUE
# SOCIAL_PRELAUNCH_SSO_CALLBACK_URL=https://YOUR_POSTBRO_HOST/api/social/sso/callback
# SOCIAL_PRELAUNCH_SSO_COOKIE_KEY=SERVER_ONLY_32_BYTE_BASE64URL_KEY

# Shared IdP consent screen: opt-in only after domain, client IDs, callback URLs
# and shared-project Auth configuration have been reviewed. No automatic signup.
SOCIAL_PRELAUNCH_CONSENT_ENABLED=false
# SOCIAL_PRELAUNCH_CONSENT_ORIGIN=https://social.syaqirshaq.online
# SOCIAL_PRELAUNCH_CONSENT_CLIENTS_JSON=[{"id":"REPLACE_WITH_POSTIZ_OAUTH_CLIENT_ID","name":"Postiz Staging","redirectUri":"https://postiz-staging.syaqirshaq.online/settings"},{"id":"REPLACE_WITH_POSTBRO_OAUTH_CLIENT_ID","name":"PostBro Social","redirectUri":"https://social.syaqirshaq.online/api/social/sso/callback"}]
# SOCIAL_PRELAUNCH_CONSENT_PILOT_EMAILS=invited-pilot@example.com
# Keep all actual values in protected server configuration. Never print keys,
# authorization IDs, session cookies, OAuth callback query strings or OTPs.
